{
    "ConnectionStrings": {
        "DefaultConnection": "Server=PRODUCTION_SERVER;Database=AutoVeo;User Id=autoveo_app;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=true"
    },
    "Jwt": {
        "Key": "CHANGE_THIS_TO_A_SECURE_KEY_MIN_32_CHARACTERS_LONG",
        "Issuer": "AutoVeo",
        "Audience": "AutoVeo",
        "ExpiryMinutes": "30",
        "RefreshTokenExpiryDays": "7"
    },
    "Cors": {
        "Origins": [
            "https://autoveo.yourdomain.com"
        ]
    },
    "Auth": {
        "MaxFailedAttempts": "5",
        "LockoutMinutes": "30"
    },
    "Veo3": {
        "BaseUrl": "https://labs.google/flow/api/v1",
        "ApiKey": "YOUR_GOOGLE_VEO3_API_KEY",
        "PollIntervalSeconds": "15",
        "MaxConcurrentJobs": "3"
    },
    "TrendCrawler": {
        "IntervalMinutes": "120"
    },
    "TrendCollector": {
        "YouTube": {
            "ApiKey": "YOUR_YOUTUBE_API_KEY"
        },
        "TikTok": {
            "AccessToken": "YOUR_TIKTOK_ACCESS_TOKEN"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Warning",
            "Override": {
                "AutoVeo": "Information",
                "Microsoft": "Error"
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning"
        }
    }
}